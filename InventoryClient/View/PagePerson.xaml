<Page x:Class="InventoryClient.View.PagePerson"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:InventoryClient.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PagePerson">
    <Page.Resources>
        <Style x:Key="ItemHeaderText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0 0 0 4"/>
        </Style>
        <Style x:Key="UserPropertyText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="Margin" Value="16 0 0 4"/>
        </Style>
        <Style x:Key="MailPropertyText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="Margin" Value="16 0 0 4"/>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="9*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Button Style="{StaticResource MaterialDesignFloatingActionButton}" ToolTip="Добавить" 
                    Width="50" Height="50" Grid.Row="0" Command="{Binding AddPersonCommand}">
                <materialDesign:PackIcon Kind="Add" Height="30" Width="30" />
            </Button>
            <Button Style="{StaticResource MaterialDesignFloatingActionButton}" ToolTip="Обновить" 
                    Width="50" Height="50" Grid.Row="1" Command="{Binding UpdatePersonCommand}" 
                    CommandParameter="{Binding ElementName=PersonList,Path=SelectedItem}">
                <materialDesign:PackIcon Kind="Update" Height="30" Width="30" />
            </Button>
            <Button Style="{StaticResource MaterialDesignFloatingActionButton}" ToolTip="Удалить" 
                    Width="50" Height="50" Grid.Row="2" Command="{Binding DeletePersonCommand}" 
                    CommandParameter="{Binding ElementName=PersonList,Path=SelectedItem}">
                <materialDesign:PackIcon Kind="Delete" Height="30" Width="30" />
            </Button>
            <Button Style="{StaticResource MaterialDesignFloatingActionButton}" ToolTip="Пользователи" 
        Width="50" Height="50" Grid.Row="3" Command="{Binding UsersCommand}">
                <materialDesign:PackIcon Kind="Users" Height="30" Width="30" />
            </Button>
        </Grid>
        <ListBox Grid.Column="0" Name="PersonList" ItemsSource="{Binding Persons}"  SelectedItem="{Binding SelectedPerson}" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <materialDesign:Card
               Background="{DynamicResource PrimaryHueDarkBrush}"
               Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"
               Padding="8"
               Width="450"
               Margin="10 10"
               UniformCornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="{Binding Personid}"
                                       Style="{StaticResource ItemHeaderText}"/>
                            <TextBlock Text="{Binding Personname}" 
                                       Style="{StaticResource UserPropertyText}"/>
                            <TextBlock Text="{Binding Email}" 
                                       Style="{StaticResource MailPropertyText}"/>
                        </StackPanel>
                    </materialDesign:Card>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>

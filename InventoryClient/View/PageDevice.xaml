<Page x:Class="InventoryClient.View.PageDevice"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:InventoryClient.View"
      xmlns:converter="clr-namespace:InventoryClient.Infrastructure.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="600"
      Title="PageDevice">
    <Page.Resources>
        <converter:CategoryidToNameConverter x:Key="CategoryIdToName"/>
        <converter:ManufactureridToNameConverter x:Key="ManufacturerIdToName"/>
        <converter:LocationidToNameConverter x:Key="LocationIdToName"/>
        <Style x:Key="ItemHeaderText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0 0 0 4"/>
        </Style>
        <Style x:Key="CatPropertyText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="Margin" Value="16 0 0 4"/>
        </Style>
        <Style x:Key="ManufPropertyText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="Margin" Value="16 0 0 4"/>
        </Style>
        <Style x:Key="LocPropertyText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="Margin" Value="16 0 0 4"/>
        </Style>
        <Style x:Key="DescPropertyText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="Margin" Value="16 0 0 4"/>
        </Style>
        <Style x:Key="DatPropertyText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="Margin" Value="16 0 0 4"/>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="9*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Button Style="{StaticResource MaterialDesignFloatingActionButton}"
                    IsEnabled="{Binding ButAddIsE}"
                    ToolTip="Добавить" 
                    Width="50" Height="50" Grid.Row="0" 
                    Command="{Binding AddCommand}">
                    <materialDesign:PackIcon Kind="Add" Height="30" Width="30" />
            </Button>
            <Button Style="{StaticResource MaterialDesignFloatingActionButton}"
                    IsEnabled="{Binding ButUpdateIsE}"
                    ToolTip="Редактировать" 
                    Width="50" Height="50" Grid.Row="1" 
                    Command="{Binding UpdateCommand}" 
                    CommandParameter="{Binding ElementName=DeviceList,Path=SelectedItem}">
                    <materialDesign:PackIcon Kind="Update" Height="30" Width="30" />
            </Button>
            <Button Style="{StaticResource MaterialDesignFloatingActionButton}"
                    IsEnabled="{Binding ButDeleteIsE}"
                    ToolTip="Удалить" 
                    Width="50" Height="50" Grid.Row="2" 
                    Command="{Binding DeleteCommand}" 
                    CommandParameter="{Binding ElementName=DeviceList,Path=SelectedItem}">
                    <materialDesign:PackIcon Kind="Delete" Height="30" Width="30" />
            </Button>
        </Grid>
        <ListBox Grid.Column="0" Name="DeviceList" ItemsSource="{Binding Devices}"  SelectedItem="{Binding SelectedDevice}" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <materialDesign:Card
                Background="{DynamicResource PrimaryHueDarkBrush}"
                Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"
                Padding="8"
                Width="450"
                Margin="10 10"
                UniformCornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource ItemHeaderText}"/>
                            <TextBlock Text="{Binding Path=Categoryid, 
                                                      Converter={StaticResource CategoryIdToName}, 
                                                      StringFormat='Категория: {0}'}"  
                                       Style="{StaticResource CatPropertyText}"/>
                            <TextBlock Text="{Binding Path=Manufacturerid, 
                                                      Converter={StaticResource ManufacturerIdToName}, 
                                                      StringFormat='Производитель: {0}'}"
                                       Style="{StaticResource ManufPropertyText}"/>
                            <TextBlock Text="{Binding Path=Locationid, 
                                                      Converter={StaticResource LocationIdToName}, 
                                                      StringFormat='Расположение: {0}'}"
                                       Style="{StaticResource LocPropertyText}"/>
                            <TextBlock Text="{Binding Description,
                                                      StringFormat='Описание: {0}'}" 
                                       Style="{StaticResource DescPropertyText}"/>
                            <TextBlock Text="{Binding Createdat,
                                       TargetNullValue='Дата не указана',
                                       StringFormat='Дата создания: {0:dd.MM.yyyy}'}"
                                       Style="{StaticResource DatPropertyText}"/>
                        </StackPanel>
                    </materialDesign:Card>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
